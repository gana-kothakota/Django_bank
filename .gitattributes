# Auto-detect text files and normalize line endings
* text=auto

# Enforce LF for python files, scripts, and docker configs (Docker container compatibility)
*.py text eol=lf
*.sh text eol=lf
*.yml text eol=lf
*.conf text eol=lf
Dockerfile* text eol=lf
.gitattributes text eol=lf

# Makefiles require tabs
Makefile text eol=lf

